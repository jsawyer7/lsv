<!DOCTYPE html>
<html lang="<%= @page.language_code %>">
  <head>
    <%= render "alchemy/pages/meta_data" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="facebook-app-id" content="<%= ENV['FACEBOOK_APP_ID'] %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= @page.title %> | VeriFaith">
    <meta property="og:description" content="<%= @page.meta_description %>">
    <meta property="og:url" content="<%= request.original_url %>">

    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/sf-pro-display">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <%= render 'shared/flash_messages' %>
    <%= render 'shared/terms_consent_modal' %>

    <%= yield %>

    <%= render "alchemy/edit_mode" %>
    <%= render 'shared/javascript' %>
    <%= render 'shared/cookies' %>
  </body>
</html>
