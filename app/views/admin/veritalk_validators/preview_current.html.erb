<div class="page-header mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1>VeriTalk active prompts</h1>
    </div>
    <div>
      <%= link_to "Back to Validators", admin_veritalk_validators_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-6">
    <div class="materio-card h-100">
      <div class="materio-header">
        <h5 class="mb-0 fw-semibold"><i class="ri ri-microscope-line me-2"></i>Forensic</h5>
      </div>
      <div class="card-body p-4">
        <% if @current_forensic&.system_prompt.present? %>
          <div class="mb-2">
            <span class="badge bg-success">Database</span>
            <span class="text-muted"><%= @current_forensic.name %> · v<%= @current_forensic.version %> · ID <%= @current_forensic.id %></span>
          </div>
          <pre class="mb-0 text-dark bg-light p-3 rounded border" style="white-space: pre-wrap; font-family: 'Courier New', monospace; font-size: 12px;"><%= @current_forensic.system_prompt %></pre>
        <% else %>
          <div class="mb-2">
            <span class="badge bg-warning text-dark">Default fallback</span>
          </div>
          <pre class="mb-0 text-dark bg-light p-3 rounded border" style="white-space: pre-wrap; font-family: 'Courier New', monospace; font-size: 12px;"><%= @fallback_forensic_prompt %></pre>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="materio-card h-100">
      <div class="materio-header">
        <h5 class="mb-0 fw-semibold"><i class="ri ri-chat-smile-line me-2"></i>Conversational</h5>
      </div>
      <div class="card-body p-4">
        <% if @current_conversational&.system_prompt.present? %>
          <div class="mb-2">
            <span class="badge bg-success">Database</span>
            <span class="text-muted"><%= @current_conversational.name %> · v<%= @current_conversational.version %> · ID <%= @current_conversational.id %></span>
          </div>
          <pre class="mb-0 text-dark bg-light p-3 rounded border" style="white-space: pre-wrap; font-family: 'Courier New', monospace; font-size: 12px;"><%= @current_conversational.system_prompt %></pre>
        <% else %>
          <div class="mb-2">
            <span class="badge bg-warning text-dark">Default fallback</span>
          </div>
          <pre class="mb-0 text-dark bg-light p-3 rounded border" style="white-space: pre-wrap; font-family: 'Courier New', monospace; font-size: 12px;"><%= @fallback_conversational_prompt %></pre>
        <% end %>
      </div>
    </div>
  </div>
</div>
