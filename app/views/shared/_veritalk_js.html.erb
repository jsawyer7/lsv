<script>
  (function() {
    var copyIconUrl = '<%= asset_path("copy.svg") %>';
    var editIconUrl = '<%= asset_path("edit_chat.svg") %>';
    var repeatIconUrl = '<%= asset_path("Repeat.svg") %>';

  function showVeritalkCopiedFlash() {
    var container = document.querySelector('.flash-container');
    if (!container) {
      container = document.createElement('div');
      container.className = 'flash-container';
      document.body.appendChild(container);
    }
    var el = document.createElement('div');
    el.className = 'flash-message notice';
    el.textContent = 'Text Copied';
    container.appendChild(el);
    setTimeout(function() {
      el.style.animation = 'slideOut 0.3s ease-out';
      setTimeout(function() {
        el.remove();
        if (container.children.length === 0) {
          container.remove();
        }
      }, 300);
    }, 2000);
  }

  var STREAM_MARK_FORENSIC = '<<<VERITALK_DUAL_FORENSIC>>>\n';
  var STREAM_MARK_CONV = '<<<VERITALK_DUAL_CONV>>>\n';

  function hideVeritalkForensicThinking() {
    var el = document.getElementById('veritalk-forensic-thinking');
    if (el) {
      el.hidden = true;
      el.setAttribute('aria-hidden', 'true');
    }
  }

  function showVeritalkForensicThinking() {
    var el = document.getElementById('veritalk-forensic-thinking');
    if (el) {
      el.hidden = false;
      el.setAttribute('aria-hidden', 'false');
    }
  }

  function hideVeritalkForensicFab() {
    var fab = document.getElementById('veritalk-forensic-fab');
    if (fab) {
      fab.hidden = true;
      fab._vtForensicDetail = '';
    }
  }

  function shrinkVeritalkForensicRail() {
    var rail = document.getElementById('veritalk-forensic-rail');
    var live = document.getElementById('veritalk-forensic-live');
    if (!rail) return;
    rail.classList.remove('veritalk-forensic-rail--streaming');
    rail.classList.remove('veritalk-forensic-rail--peek');
    rail.setAttribute('aria-hidden', 'true');
    hideVeritalkForensicThinking();
    hideVeritalkForensicFab();
    if (live) live.textContent = '';
  }

  var vtForensicGuideListeners = null;

  function forensicGuideStorageKey() {
    var el = document.querySelector('.veritalk-container[data-user-id]');
    var uid = el && el.getAttribute('data-user-id');
    return 'veritalk_forensic_guide_v1_' + (uid && String(uid).length ? String(uid) : 'anon');
  }

  function teardownVeritalkForensicGuide() {
    var g = document.getElementById('veritalk-forensic-guide');
    if (g) g.remove();
    if (vtForensicGuideListeners) {
      window.removeEventListener('resize', vtForensicGuideListeners.onMove);
      window.removeEventListener('scroll', vtForensicGuideListeners.onMove);
      if (vtForensicGuideListeners.messagesEl) {
        vtForensicGuideListeners.messagesEl.removeEventListener('scroll', vtForensicGuideListeners.onMove);
      }
      if (vtForensicGuideListeners.resizeObs) {
        vtForensicGuideListeners.resizeObs.disconnect();
      }
      if (vtForensicGuideListeners.visualViewport) {
        var vv = vtForensicGuideListeners.visualViewport;
        vv.removeEventListener('resize', vtForensicGuideListeners.onMove);
        vv.removeEventListener('scroll', vtForensicGuideListeners.onMove);
      }
      if (vtForensicGuideListeners.deferTimer) {
        clearTimeout(vtForensicGuideListeners.deferTimer);
      }
      vtForensicGuideListeners = null;
    }
  }

  function dismissForensicGuideForever() {
    try {
      localStorage.setItem(forensicGuideStorageKey(), '1');
    } catch (e) {}
    teardownVeritalkForensicGuide();
  }

  function maybeShowForensicGuideNearChip(assistantRowEl) {
    if (!assistantRowEl) return;
    try {
      if (localStorage.getItem(forensicGuideStorageKey()) === '1') return;
    } catch (e) {
      return;
    }
    if (document.getElementById('veritalk-forensic-guide')) return;

    var anchor = assistantRowEl.querySelector('button.veritalk-forensic-chip');
    if (!anchor) return;

    var guide = document.createElement('div');
    guide.id = 'veritalk-forensic-guide';
    guide.className = 'veritalk-forensic-guide';
    guide.setAttribute('role', 'dialog');
    guide.setAttribute('aria-labelledby', 'veritalk-forensic-guide-title');

    var title = document.createElement('div');
    title.className = 'veritalk-forensic-guide__title';
    title.id = 'veritalk-forensic-guide-title';
    title.textContent = 'Forensic detail';

    var text = document.createElement('p');
    text.className = 'veritalk-forensic-guide__text';
    text.textContent = 'Click the microscope beside each assistant reply to open the full forensic breakdown.';

    var actions = document.createElement('div');
    actions.className = 'veritalk-forensic-guide__actions';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'veritalk-forensic-guide__btn';
    btn.textContent = 'Got it';
    btn.addEventListener('click', function(ev) {
      ev.preventDefault();
      dismissForensicGuideForever();
    });
    actions.appendChild(btn);

    guide.appendChild(title);
    guide.appendChild(text);
    guide.appendChild(actions);

    var host = document.querySelector('.veritalk-chat-main');

    if (host) {
      host.appendChild(guide);
      guide.style.position = 'absolute';
    } else {
      document.body.appendChild(guide);
      guide.style.position = 'fixed';
    }

    var guideLayoutAttempts = 0;
    var guideHostReadyAttempts = 0;

    function positionGuide() {
      if (!document.body.contains(anchor) || !document.body.contains(guide)) return;
      if (host && (!host.contains(anchor) || !host.contains(guide))) return;
      var cr = anchor.getBoundingClientRect();
      if (cr.width <= 0 || cr.height <= 0) {
        if (guideHostReadyAttempts < 120) {
          guideHostReadyAttempts += 1;
          requestAnimationFrame(positionGuide);
        }
        return;
      }
      var pad = 10;
      var gw = guide.offsetWidth;
      var gh = guide.offsetHeight;
      if (gw < 2 || gh < 2) {
        if (guideLayoutAttempts < 40) {
          guideLayoutAttempts += 1;
          requestAnimationFrame(positionGuide);
        }
        return;
      }
      var flip = false;
      var leftPx;
      var topPx;

      if (host) {
        var mr = host.getBoundingClientRect();
        var edge = 8;
        var mw = host.clientWidth;
        var mh = host.clientHeight;
        /* Flex/layout can briefly report mw/mh≈0 before .veritalk-chat-main settles. Clamping
           with near-zero mw forces left/top to edge (~8px) — tooltip sticks top-left until a
           real resize (e.g. DevTools) recomputes. Wait until dimensions are sane. */
        var minDim = Math.min(140, gw + pad * 4);
        var hostStable = mw >= minDim && mh >= 72 && mr.width >= minDim && mr.height >= 72;
        if (!hostStable && guideHostReadyAttempts < 120) {
          guideHostReadyAttempts += 1;
          requestAnimationFrame(positionGuide);
          return;
        }

        leftPx = cr.right - mr.left + pad;
        if (leftPx + gw > mw - edge) {
          leftPx = cr.left - mr.left - gw - pad;
          flip = true;
        }
        leftPx = Math.min(Math.max(leftPx, edge), Math.max(edge, mw - gw - edge));

        topPx = cr.top - mr.top + cr.height / 2 - gh / 2;
        topPx = Math.min(Math.max(topPx, edge), Math.max(edge, mh - gh - edge));
      } else {
        leftPx = cr.right + pad;
        if (leftPx + gw > window.innerWidth - 16) {
          leftPx = cr.left - gw - pad;
          flip = true;
        }
        leftPx = Math.min(Math.max(leftPx, 16), Math.max(16, window.innerWidth - 16 - gw));
        topPx = cr.top + cr.height / 2 - gh / 2;
        topPx = Math.min(Math.max(topPx, 16), Math.max(16, window.innerHeight - 16 - gh));
      }

      guide.style.left = Math.round(leftPx) + 'px';
      guide.style.top = Math.round(topPx) + 'px';
      guide.classList.toggle('veritalk-forensic-guide--flip', flip);
    }

    var onMove = function() {
      requestAnimationFrame(positionGuide);
    };
    requestAnimationFrame(function() {
      requestAnimationFrame(positionGuide);
    });
    window.addEventListener('resize', onMove);
    window.addEventListener('scroll', onMove, { passive: true });
    var md = document.getElementById('veritalk-messages');
    if (md) md.addEventListener('scroll', onMove, { passive: true });

    var resizeObs = null;
    if (host && typeof ResizeObserver !== 'undefined') {
      resizeObs = new ResizeObserver(onMove);
      resizeObs.observe(host);
    }

    var visualViewportEl = typeof window.visualViewport !== 'undefined' ? window.visualViewport : null;
    if (visualViewportEl) {
      visualViewportEl.addEventListener('resize', onMove);
      visualViewportEl.addEventListener('scroll', onMove);
    }

    var deferTimer = null;
    if (typeof document !== 'undefined' && document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function() {
        requestAnimationFrame(positionGuide);
      });
    }
    deferTimer = setTimeout(function() {
      deferTimer = null;
      requestAnimationFrame(positionGuide);
    }, 200);

    vtForensicGuideListeners = {
      onMove: onMove,
      messagesEl: md,
      resizeObs: resizeObs,
      visualViewport: visualViewportEl,
      deferTimer: deferTimer,
    };
  }

  function collapseForensicRailToFab(forensicDetail) {
    var rail = document.getElementById('veritalk-forensic-rail');
    var live = document.getElementById('veritalk-forensic-live');
    var fab = document.getElementById('veritalk-forensic-fab');
    if (!rail) return;
    rail.classList.remove('veritalk-forensic-rail--streaming');
    rail.classList.remove('veritalk-forensic-rail--peek');
    rail.setAttribute('aria-hidden', 'true');
    hideVeritalkForensicThinking();
    if (live) live.textContent = '';
    var text = String(forensicDetail || '').trim();
    if (fab && text) {
      fab._vtForensicDetail = text;
      fab.hidden = false;
    } else if (fab) {
      hideVeritalkForensicFab();
    }
  }

  function openVeritalkForensicPeek(forensicDetail, heading) {
    var rail = document.getElementById('veritalk-forensic-rail');
    var live = document.getElementById('veritalk-forensic-live');
    var titleEl = document.getElementById('veritalk-forensic-rail-title');
    if (!rail || !live) return;
    if (titleEl && heading) titleEl.textContent = heading;
    hideVeritalkForensicThinking();
    live.textContent = forensicDetail || '';
    rail.classList.remove('veritalk-forensic-rail--streaming');
    rail.classList.add('veritalk-forensic-rail--peek');
    rail.setAttribute('aria-hidden', 'false');
  }

  function closeVeritalkForensicPeek() {
    var rail = document.getElementById('veritalk-forensic-rail');
    var live = document.getElementById('veritalk-forensic-live');
    if (!rail) return;
    rail.classList.remove('veritalk-forensic-rail--peek');
    rail.setAttribute('aria-hidden', 'true');
    if (live) live.textContent = '';
  }

  function createAssistantMessageContent(initialText, forensicDetail) {
    var contentDiv = document.createElement('div');
    contentDiv.className = 'veritalk-message-content';
    var textDiv = document.createElement('div');
    textDiv.className = 'veritalk-message-text';
    textDiv.textContent = initialText || '';
    var actionsDiv = document.createElement('div');
    actionsDiv.className = 'veritalk-message-actions';
    var copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.setAttribute('aria-label', 'Copy');
    var copyImg = document.createElement('img');
    copyImg.src = copyIconUrl;
    copyImg.alt = '';
    copyImg.width = 18;
    copyImg.height = 18;
    copyBtn.appendChild(copyImg);
    var repeatBtn = document.createElement('button');
    repeatBtn.type = 'button';
    repeatBtn.className = 'veritalk-regenerate-btn';
    repeatBtn.setAttribute('aria-label', 'Regenerate response');
    var repeatImg = document.createElement('img');
    repeatImg.src = repeatIconUrl;
    repeatImg.alt = '';
    repeatImg.width = 18;
    repeatImg.height = 18;
    repeatBtn.appendChild(repeatImg);
    actionsDiv.appendChild(copyBtn);
    actionsDiv.appendChild(repeatBtn);
    contentDiv.appendChild(textDiv);
    contentDiv.appendChild(actionsDiv);
    copyBtn.addEventListener('click', function() {
      var text = textDiv.textContent || '';
      if (text && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          showVeritalkCopiedFlash();
        }).catch(function() {});
      }
    });
    var forensicChip = null;
    if (forensicDetail && String(forensicDetail).trim()) {
      forensicChip = document.createElement('button');
      forensicChip.type = 'button';
      forensicChip.className = 'veritalk-forensic-chip';
      forensicChip.setAttribute('aria-label', 'Show forensic detail');
      forensicChip.setAttribute('title', 'Forensic detail');
      forensicChip.innerHTML = '<i class="fas fa-microscope"></i>';
      forensicChip._vtForensicDetail = String(forensicDetail);
      forensicChip.addEventListener('click', function(ev) {
        ev.stopPropagation();
        openVeritalkForensicPeek(forensicChip._vtForensicDetail, 'Forensic detail');
      });
    } else {
      forensicChip = document.createElement('div');
      forensicChip.className = 'veritalk-forensic-turn-spacer';
      forensicChip.setAttribute('aria-hidden', 'true');
    }
    return { contentDiv: contentDiv, textDiv: textDiv, forensicChip: forensicChip };
  }

  function createUserTurnForensicSlot() {
    var slot = document.createElement('div');
    slot.className = 'veritalk-forensic-turn-slot veritalk-forensic-turn-slot--user';
    slot.setAttribute('aria-hidden', 'true');
    slot.innerHTML = '<span class="veritalk-forensic-turn-slot-icon" title="Your message"><i class="fas fa-user"></i></span>';
    return slot;
  }

  function createUserMessageContent(initialText) {
    var contentDiv = document.createElement('div');
    contentDiv.className = 'veritalk-message-content';
    var textDiv = document.createElement('div');
    textDiv.className = 'veritalk-message-text';
    textDiv.textContent = initialText || '';
    var actionsDiv = document.createElement('div');
    actionsDiv.className = 'veritalk-message-actions';
    var copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.setAttribute('aria-label', 'Copy');
    var copyImg = document.createElement('img');
    copyImg.src = copyIconUrl;
    copyImg.alt = '';
    copyImg.width = 18;
    copyImg.height = 18;
    copyBtn.appendChild(copyImg);
    var editBtn = document.createElement('button');
    editBtn.type = 'button';
    editBtn.setAttribute('aria-label', 'Edit');
    var editImg = document.createElement('img');
    editImg.src = editIconUrl;
    editImg.alt = '';
    editImg.width = 18;
    editImg.height = 18;
    editBtn.appendChild(editImg);
    actionsDiv.appendChild(copyBtn);
    actionsDiv.appendChild(editBtn);
    contentDiv.appendChild(textDiv);
    contentDiv.appendChild(actionsDiv);
    copyBtn.addEventListener('click', function() {
      var text = textDiv.textContent || '';
      if (text && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          showVeritalkCopiedFlash();
        }).catch(function() {});
      }
    });
    editBtn.addEventListener('click', function() {
      var inputEl = document.getElementById('veritalk-input');
      if (inputEl) {
        inputEl.value = textDiv.textContent || '';
        inputEl.dispatchEvent(new Event('input', { bubbles: true }));
        inputEl.focus();
      }
    });
    return { contentDiv: contentDiv, textDiv: textDiv };
  }

  function wireUserForensicSlot(slotEl, messageDiv) {
    if (!slotEl || !messageDiv) return;
    slotEl.style.cursor = 'pointer';
    slotEl.setAttribute('title', 'Open forensic detail for the reply below');
    slotEl.addEventListener('click', function(ev) {
      ev.stopPropagation();
      var next = messageDiv.nextElementSibling;
      while (next && !next.classList.contains('veritalk-message')) next = next.nextElementSibling;
      if (!next || !next.classList.contains('assistant')) return;
      var chip = next.querySelector('.veritalk-forensic-chip');
      if (chip && chip._vtForensicDetail) {
        openVeritalkForensicPeek(chip._vtForensicDetail, 'Forensic detail');
      }
    });
  }

  // Show "How can I help you today?" only when chat is empty (no messages)
  function updateVeritalkInputHeadingVisibility() {
    const block = document.querySelector('.veritalk-input-block');
    const messagesDiv = document.getElementById('veritalk-messages');
    if (!block || !messagesDiv) return;
    const hasMessages = messagesDiv.querySelectorAll('.veritalk-message').length > 0;
    block.classList.toggle('veritalk-input-block--has-messages', !!hasMessages);
  }

  function buildVeritalkMessageDiv(msg, suppressAnimation) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'veritalk-message ' + msg.role;
    if (suppressAnimation) messageDiv.style.animation = 'none';
    if (msg.role === 'assistant') {
      var result = createAssistantMessageContent(msg.content, msg.forensic_content || null);
      if (msg.forensic_content && String(msg.forensic_content).trim()) {
        messageDiv.classList.add('has-forensic');
      }
      messageDiv.appendChild(result.forensicChip);
      messageDiv.appendChild(result.contentDiv);
    } else {
      var slot = createUserTurnForensicSlot();
      var u = createUserMessageContent(msg.content);
      messageDiv.appendChild(slot);
      messageDiv.appendChild(u.contentDiv);
      wireUserForensicSlot(slot, messageDiv);
    }
    return messageDiv;
  }

  // Use both DOMContentLoaded and window load to ensure everything is ready
  function initVeritalk() {
    const form = document.getElementById('veritalk-form');
    const input = document.getElementById('veritalk-input');
    const messagesDiv = document.getElementById('veritalk-messages');
    const conversationIdInput = document.getElementById('veritalk-conversation-id');

    if (!form || !input || !messagesDiv) {
      console.log('VeriTalk elements not found, retrying...');
      // Retry after a short delay if elements aren't ready
      setTimeout(initVeritalk, 200);
      return;
    }

    console.log('VeriTalk initialized');

    var forensicRailCloseBtn = document.getElementById('veritalk-forensic-rail-close');
    if (forensicRailCloseBtn) {
      forensicRailCloseBtn.addEventListener('click', function() {
        closeVeritalkForensicPeek();
      });
    }

    var forensicFab = document.getElementById('veritalk-forensic-fab');
    if (forensicFab) {
      forensicFab.addEventListener('click', function() {
        var detail = forensicFab._vtForensicDetail;
        if (detail) openVeritalkForensicPeek(detail, 'Forensic analysis');
      });
    }

    let isStreaming = false;
    
    // Initialize send button state
    const sendBtn = document.getElementById('veritalk-send-btn');
    if (sendBtn) {
      sendBtn.disabled = !input.value.trim();
    }

    var VERITALK_INPUT_MAX_HEIGHT = 120;

    function resizeVeritalkInput() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, VERITALK_INPUT_MAX_HEIGHT) + 'px';
    }

    resizeVeritalkInput();

    // Load conversation history on page load
    async function loadConversationHistory() {
      console.log('Loading conversation history...');
      
      // Try to get conversation_id from localStorage first
      let conversationId = localStorage.getItem('veritalk_conversation_id');
      console.log('Conversation ID from localStorage:', conversationId);
      
      // If no conversation_id in localStorage, try to get from hidden input (for new conversations)
      if (!conversationId && conversationIdInput && conversationIdInput.value) {
        conversationId = conversationIdInput.value;
        console.log('Conversation ID from hidden input:', conversationId);
      }

      // If still no conversation_id, try to get the latest conversation
      if (!conversationId) {
        try {
          console.log('Fetching latest conversation...');
          const response = await fetch('/veritalk/latest');
          if (response.ok) {
            const data = await response.json();
            console.log('Latest conversation data:', data);
            if (data.conversation_id) {
              conversationId = data.conversation_id;
              console.log('Using latest conversation ID:', conversationId);
            }
          }
        } catch (error) {
          console.error('Error fetching latest conversation:', error);
        }
      }

      // Load messages if we have a conversation_id
      if (conversationId) {
        try {
          console.log('Loading messages for conversation:', conversationId);
          const response = await fetch(`/veritalk/conversation/${conversationId}/messages`);
          if (response.ok) {
            const data = await response.json();
            console.log('Loaded conversation data:', data);
            
            // Store conversation_id
            if (conversationIdInput) {
              conversationIdInput.value = data.conversation_id;
            }
            localStorage.setItem('veritalk_conversation_id', data.conversation_id);

            // Clear welcome message
            const welcome = messagesDiv.querySelector('.veritalk-welcome');
            if (welcome) {
              welcome.remove();
            }

            // Load messages
            if (data.messages && data.messages.length > 0) {
              console.log('Loading', data.messages.length, 'messages');
              // Clear any existing messages first (including welcome message)
              teardownVeritalkForensicGuide();
              messagesDiv.innerHTML = '';
              
              data.messages.forEach(function(msg, index) {
                appendMessage(msg.role, msg.content, false, msg.forensic_content || null);
              });
              
              // Scroll to bottom after a brief delay to ensure DOM is updated
              setTimeout(() => {
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
              }, 50);
              
              console.log('Messages loaded successfully');
            } else {
              console.log('No messages found in conversation');
              // Keep welcome message if no messages
            }
            updateVeritalkInputHeadingVisibility();
          } else {
            console.log('Conversation not found, clearing localStorage');
            // Conversation not found, clear localStorage
            localStorage.removeItem('veritalk_conversation_id');
            if (conversationIdInput) {
              conversationIdInput.value = '';
            }
          }
        } catch (error) {
          console.error('Error loading conversation history:', error);
        }
      } else {
        console.log('No conversation ID found, showing welcome message');
      }
      updateVeritalkInputHeadingVisibility();
    }

    // Load history on page load - use a small delay to ensure DOM is ready
    setTimeout(() => {
      loadConversationHistory();
    }, 200);

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || isStreaming) return;

      appendMessage('user', text);
      input.value = '';
      resizeVeritalkInput();

      startVeritalkStream(text);
    });

    messagesDiv.addEventListener('click', function(e) {
      var repeatBtn = e.target.closest('.veritalk-regenerate-btn');
      if (!repeatBtn || isStreaming) return;
      var assistantMsg = repeatBtn.closest('.veritalk-message.assistant');
      if (!assistantMsg) return;
      var prev = assistantMsg.previousElementSibling;
      if (!prev || !prev.classList.contains('user')) return;
      var textEl = prev.querySelector('.veritalk-message-text');
      var text = textEl ? textEl.textContent.trim() : '';
      if (!text) return;
      assistantMsg.remove();
      startVeritalkStream(text);
    });

    input.addEventListener('input', function() {
      resizeVeritalkInput();
      var sendBtn = document.getElementById('veritalk-send-btn');
      if (sendBtn) {
        sendBtn.disabled = !this.value.trim() || isStreaming;
      }
    });

    // Handle Enter key (Shift+Enter for new line)
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (!isStreaming && this.value.trim()) {
          form.dispatchEvent(new Event('submit'));
        }
      }
    });

    function appendMessage(role, content, animate = true, forensicContent = null) {
      // Remove welcome message if it exists
      const welcome = messagesDiv.querySelector('.veritalk-welcome');
      if (welcome) {
        welcome.remove();
      }

      const messageDiv = document.createElement('div');
      messageDiv.className = 'veritalk-message ' + role;
      if (!animate) {
        messageDiv.style.animation = 'none';
      }
      
      if (role === 'assistant') {
        var result = createAssistantMessageContent(content, forensicContent);
        if (forensicContent && String(forensicContent).trim()) {
          messageDiv.classList.add('has-forensic');
        }
        messageDiv.appendChild(result.forensicChip);
        messageDiv.appendChild(result.contentDiv);
      } else {
        var slot = createUserTurnForensicSlot();
        var result = createUserMessageContent(content);
        messageDiv.appendChild(slot);
        messageDiv.appendChild(result.contentDiv);
        wireUserForensicSlot(slot, messageDiv);
      }
      
      messagesDiv.appendChild(messageDiv);
      messagesDiv.scrollTop = messagesDiv.scrollHeight;
      updateVeritalkInputHeadingVisibility();
      return messageDiv;
    }

    async function startVeritalkStream(message) {
      if (document.getElementById('veritalk-forensic-guide')) {
        dismissForensicGuideForever();
      }
      isStreaming = true;
      input.disabled = true;
      const sendCtrl = document.getElementById('veritalk-send-btn');
      if (sendCtrl) sendCtrl.disabled = true;

      closeVeritalkForensicPeek();
      hideVeritalkForensicFab();

      var rail = document.getElementById('veritalk-forensic-rail');
      var forensicLive = document.getElementById('veritalk-forensic-live');
      var forensicTitle = document.getElementById('veritalk-forensic-rail-title');
      if (rail && forensicLive && forensicTitle) {
        forensicTitle.textContent = 'Forensic analysis';
        forensicLive.textContent = '';
        hideVeritalkForensicFab();
        showVeritalkForensicThinking();
        rail.classList.add('veritalk-forensic-rail--streaming');
        rail.classList.remove('veritalk-forensic-rail--peek');
        rail.setAttribute('aria-hidden', 'false');
      }

      const welcome = messagesDiv.querySelector('.veritalk-welcome');
      if (welcome) welcome.remove();

      function unlockVeritalkInput() {
        isStreaming = false;
        input.disabled = false;
        input.focus();
        var sb = document.getElementById('veritalk-send-btn');
        if (sb) sb.disabled = !input.value.trim();
      }

      function showStreamErrorAssistant(userText, useForensic) {
        shrinkVeritalkForensicRail();
        appendMessage('assistant', userText, true, useForensic || null);
        updateVeritalkInputHeadingVisibility();
      }

      const payload = { message: message };
      if (conversationIdInput && conversationIdInput.value) {
        payload.conversation_id = conversationIdInput.value;
      }

      var assistantRowEl = null;
      var streamTextDiv = null;
      var streamState = { phase: 'seek_f', buf: '' };
      var forensicAccum = '';
      var assistantText = '';

      function ingestDecodedChunk(txt) {
        streamState.buf += txt;
        for (;;) {
          var b = streamState.buf;
          if (streamState.phase === 'seek_f') {
            var ix = b.indexOf(STREAM_MARK_FORENSIC);
            if (ix === -1) {
              var kf = STREAM_MARK_FORENSIC.length - 1;
              streamState.buf = b.length <= kf ? b : b.slice(-kf);
              return;
            }
            streamState.buf = b.slice(ix + STREAM_MARK_FORENSIC.length);
            streamState.phase = 'forensic';
            continue;
          }
          if (streamState.phase === 'forensic') {
            var jc = b.indexOf(STREAM_MARK_CONV);
            if (jc !== -1) {
              forensicAccum += b.slice(0, jc);
              if (forensicLive) forensicLive.textContent = forensicAccum;
              streamState.buf = b.slice(jc + STREAM_MARK_CONV.length);
              streamState.phase = 'conv';
              hideVeritalkForensicThinking();
              collapseForensicRailToFab(forensicAccum);
              assistantRowEl = appendMessage('assistant', '', true, forensicAccum);
              streamTextDiv = assistantRowEl ? assistantRowEl.querySelector('.veritalk-message-text') : null;
              if (assistantRowEl) {
                requestAnimationFrame(function() {
                  requestAnimationFrame(function() {
                    maybeShowForensicGuideNearChip(assistantRowEl);
                  });
                });
              }
              continue;
            }
            var keep = STREAM_MARK_CONV.length - 1;
            if (b.length <= keep) return;
            forensicAccum += b.slice(0, b.length - keep);
            if (forensicAccum.trim()) hideVeritalkForensicThinking();
            if (forensicLive) forensicLive.textContent = forensicAccum;
            streamState.buf = b.slice(b.length - keep);
            return;
          }
          if (streamState.phase === 'conv') {
            assistantText += b;
            streamState.buf = '';
            if (streamTextDiv) {
              streamTextDiv.textContent = assistantText;
              messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }
            return;
          }
          return;
        }
      }

      try {
        const response = await fetch('/veritalk/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          var errorRaw = await response.text();
          var errMsg = errorRaw.includes('<!DOCTYPE html>') || errorRaw.includes('<html>')
            ? 'AI features require an active subscription. Please upgrade your plan to use VeriTalk.'
            : (errorRaw || 'Sorry, VeriTalk had a problem.');
          showStreamErrorAssistant(errMsg, null);
          unlockVeritalkInput();
          return;
        }

        const contentType = response.headers.get('Content-Type');
        if (contentType && !contentType.includes('text/event-stream') && !contentType.includes('text/plain')) {
          showStreamErrorAssistant('AI features require an active subscription. Please upgrade your plan to use VeriTalk.', null);
          unlockVeritalkInput();
          return;
        }

        var newConversationId = response.headers.get('X-Veritalk-Conversation-Id');
        if (newConversationId) {
          if (conversationIdInput) conversationIdInput.value = newConversationId;
          localStorage.setItem('veritalk_conversation_id', newConversationId);
        }

        if (!response.body) {
          showStreamErrorAssistant('Sorry, VeriTalk had a problem.', null);
          unlockVeritalkInput();
          return;
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          if (!value) continue;
          ingestDecodedChunk(decoder.decode(value, { stream: true }));
        }

        if (streamState.phase === 'seek_f') {
          var legacyBody = streamState.buf.trim();
          if (legacyBody && !assistantRowEl) {
            shrinkVeritalkForensicRail();
            assistantRowEl = appendMessage('assistant', legacyBody, true, null);
          }
        } else if (streamState.phase === 'forensic') {
          if (!assistantRowEl && forensicAccum) {
            shrinkVeritalkForensicRail();
            showStreamErrorAssistant('VeriTalk stopped before completing the conversational reply.', forensicAccum);
          }
        } else if (streamState.phase === 'conv' && streamState.buf) {
          assistantText += streamState.buf;
          streamState.buf = '';
          if (streamTextDiv) {
            streamTextDiv.textContent = assistantText;
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
          }
        }

        unlockVeritalkInput();
      } catch (error) {
        console.error('VeriTalk error:', error);
        shrinkVeritalkForensicRail();
        appendMessage('assistant', 'Sorry, VeriTalk is unavailable right now.', true, null);
        unlockVeritalkInput();
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVeritalk);
  } else {
    // DOM is already ready
    initVeritalk();
  }

  // Also try on window load as a fallback
  window.addEventListener('load', function() {
    // Only load history if messages div is empty (hasn't been loaded yet)
    const messagesDiv = document.getElementById('veritalk-messages');
    if (messagesDiv && messagesDiv.querySelectorAll('.veritalk-message').length === 0) {
      const welcome = messagesDiv.querySelector('.veritalk-welcome');
      // If only welcome message exists, try loading history
      if (welcome && messagesDiv.children.length === 1) {
        console.log('Window loaded, checking for conversation history...');
        const conversationId = localStorage.getItem('veritalk_conversation_id');
        if (conversationId) {
          fetch(`/veritalk/conversation/${conversationId}/messages`)
            .then(response => response.json())
            .then(data => {
              if (data.messages && data.messages.length > 0) {
                welcome.remove();
                data.messages.forEach(function(msg) {
                  messagesDiv.appendChild(buildVeritalkMessageDiv(msg, true));
                });
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
                updateVeritalkInputHeadingVisibility();
                
                const conversationIdInput = document.getElementById('veritalk-conversation-id');
                if (conversationIdInput) {
                  conversationIdInput.value = data.conversation_id;
                }
              }
            })
            .catch(error => console.error('Error loading history on window load:', error));
        }
      }
    }
  });

  // History Sidebar Functionality
  document.addEventListener('DOMContentLoaded', function() {
    const historyBtn = document.getElementById('veritalk-history-btn');
    const historySidebar = document.getElementById('veritalk-history-sidebar');
    const historyClose = document.getElementById('veritalk-history-close');
    const historyOverlay = document.getElementById('veritalk-history-overlay');
    const newChatBtn = document.getElementById('veritalk-new-chat-btn');
    const conversationsList = document.getElementById('veritalk-conversations-list');
    const conversationIdInput = document.getElementById('veritalk-conversation-id');
    const messagesDiv = document.getElementById('veritalk-messages');

    if (!historyBtn || !historySidebar || !historyClose || !historyOverlay) {
      return;
    }

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.veritalk-conversation-actions')) {
        document.querySelectorAll('.veritalk-conversation-dropdown').forEach(el => { el.hidden = true; });
        document.querySelectorAll('.veritalk-conversation-item').forEach(el => el.classList.remove('veritalk-conversation-item--dropdown-open'));
      }
    });

    const historySearchInput = document.getElementById('veritalk-history-search');
    if (historySearchInput) {
      historySearchInput.addEventListener('input', function() {
        const q = (this.value || '').trim().toLowerCase();
        const list = document.getElementById('veritalk-conversations-list');
        if (!list) return;
        list.querySelectorAll('.veritalk-conversation-item').forEach(function(item) {
          const topic = (item.querySelector('.veritalk-conversation-topic')?.textContent || '').toLowerCase();
          item.style.display = q === '' || topic.indexOf(q) !== -1 ? '' : 'none';
        });
      });
    }

    // Open sidebar
    function openHistorySidebar() {
      // Close user profile dropdown if open
      const dropdownMenu = document.querySelector('.dropdown-menu');
      const userInfo = document.querySelector('.user-info');
      if (dropdownMenu && dropdownMenu.classList.contains('show')) {
        dropdownMenu.classList.remove('show');
        if (userInfo) {
          userInfo.classList.remove('active');
        }
      }
      
      historySidebar.classList.add('active');
      historyOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      loadConversationsList();
    }

    // Close sidebar
    function closeHistorySidebar() {
      historySidebar.classList.remove('active');
      historyOverlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    async function deleteConversation(conversationId, itemEl) {
      const currentConvId = conversationIdInput ? conversationIdInput.value : localStorage.getItem('veritalk_conversation_id');
      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const response = await fetch(`/veritalk/conversation/${conversationId}`, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken || '', 'Content-Type': 'application/json' }
        });
        if (!response.ok) return;
      } catch (e) {
        return;
      }
      if (itemEl && itemEl.parentNode) itemEl.remove();
      if (currentConvId && currentConvId == conversationId) {
        startNewChat();
      }
    }

    // Load conversations list
    async function loadConversationsList() {
      if (!conversationsList) return;

      conversationsList.innerHTML = '<div class="veritalk-history-loading">Loading conversations...</div>';

      try {
        const response = await fetch('/veritalk/conversations');
        if (response.ok) {
          const data = await response.json();
          
          if (data.conversations && data.conversations.length > 0) {
            conversationsList.innerHTML = '';
            const threeDotSrc = document.getElementById('veritalk-three-dot-src')?.getAttribute('src') || '';
            
            data.conversations.forEach(conv => {
              const item = document.createElement('div');
              item.className = 'veritalk-conversation-item';
              item.dataset.conversationId = conv.id;
              
              const currentConvId = conversationIdInput ? conversationIdInput.value : localStorage.getItem('veritalk_conversation_id');
              if (currentConvId && currentConvId == conv.id) {
                item.classList.add('active');
              }
              
              item.innerHTML = `
                <div class="veritalk-conversation-topic">${escapeHtml(conv.topic)}</div>
                <div class="veritalk-conversation-actions">
                  <button type="button" class="veritalk-conversation-menu-btn" aria-label="Options">
                    <img src="${escapeHtml(threeDotSrc)}" width="20" height="20" alt="">
                  </button>
                  <div class="veritalk-conversation-dropdown" role="menu" hidden>
                    <button type="button" class="veritalk-conversation-delete" role="menuitem">Delete</button>
                  </div>
                </div>
              `;
              
              item.addEventListener('click', function(e) {
                if (e.target.closest('.veritalk-conversation-actions')) return;
                loadConversation(conv.id);
                closeHistorySidebar();
              });
              
              const menuBtn = item.querySelector('.veritalk-conversation-menu-btn');
              const dropdown = item.querySelector('.veritalk-conversation-dropdown');
              const deleteBtn = item.querySelector('.veritalk-conversation-delete');
              if (menuBtn && dropdown) {
                menuBtn.addEventListener('click', function(e) {
                  e.preventDefault();
                  e.stopPropagation();
                  const isOpen = !dropdown.hidden;
                  document.querySelectorAll('.veritalk-conversation-dropdown').forEach(el => { el.hidden = true; });
                  document.querySelectorAll('.veritalk-conversation-item').forEach(el => el.classList.remove('veritalk-conversation-item--dropdown-open'));
                  dropdown.hidden = isOpen;
                  if (!dropdown.hidden) item.classList.add('veritalk-conversation-item--dropdown-open');
                });
              }
              if (deleteBtn) {
                deleteBtn.addEventListener('click', function(e) {
                  e.preventDefault();
                  e.stopPropagation();
                  dropdown.hidden = true;
                  deleteConversation(conv.id, item);
                });
              }
              
              conversationsList.appendChild(item);
            });
          } else {
            conversationsList.innerHTML = `
              <div class="veritalk-empty-history">
                <h3>No chat history available</h3>
                <p>Your future conversations will appear here.</p>
              </div>
            `;
          }
        } else {
          conversationsList.innerHTML = '<div class="veritalk-history-loading">Error loading conversations</div>';
        }
      } catch (error) {
        console.error('Error loading conversations:', error);
        conversationsList.innerHTML = '<div class="veritalk-history-loading">Error loading conversations</div>';
      }
    }

    // Load a specific conversation
    async function loadConversation(conversationId) {
      if (!messagesDiv) return;

      try {
        const response = await fetch(`/veritalk/conversation/${conversationId}/messages`);
        if (response.ok) {
          const data = await response.json();
          
          // Store conversation_id
          if (conversationIdInput) {
            conversationIdInput.value = data.conversation_id;
          }
          localStorage.setItem('veritalk_conversation_id', data.conversation_id);

          // Clear messages and load new ones
          teardownVeritalkForensicGuide();
          messagesDiv.innerHTML = '';
          
          if (data.messages && data.messages.length > 0) {
            data.messages.forEach(function(msg) {
              messagesDiv.appendChild(buildVeritalkMessageDiv(msg, true));
            });
            
            setTimeout(function() {
              messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }, 50);
          }
          updateVeritalkInputHeadingVisibility();
          
          // Reload conversations list to update active state
          loadConversationsList();
        }
      } catch (error) {
        console.error('Error loading conversation:', error);
      }
    }

    // Start new chat
    function startNewChat() {
      teardownVeritalkForensicGuide();
      shrinkVeritalkForensicRail();
      closeVeritalkForensicPeek();
      if (conversationIdInput) {
        conversationIdInput.value = '';
      }
      localStorage.removeItem('veritalk_conversation_id');
      
      // Clear messages and show welcome
      if (messagesDiv) {
        const container = document.querySelector('.veritalk-container[data-user-name]') || document.querySelector('#veritalk-messages')?.closest('.veritalk-container');
        const userName = (container && container.dataset.userName) ? container.dataset.userName : 'there';
        const welcomeText = `Whats in your mind, ${userName}?`;
        messagesDiv.innerHTML = `
          <div class="veritalk-welcome">
            <p class="veritalk-welcome-text">${welcomeText}</p>
          </div>
        `;
        const inputEl = document.getElementById('veritalk-input');
        if (inputEl) inputEl.placeholder = welcomeText;
        updateVeritalkInputHeadingVisibility();
      }
      
      closeHistorySidebar();
    }

    // Helper functions
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const diffTime = Math.abs(now - date);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      
      if (diffDays === 1) {
        return 'Today';
      } else if (diffDays === 2) {
        return 'Yesterday';
      } else if (diffDays <= 7) {
        return `${diffDays - 1} days ago`;
      } else {
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      }
    }

    // Event listeners
    if (historyBtn) {
      historyBtn.addEventListener('click', openHistorySidebar);
    }

    if (historyClose) {
      historyClose.addEventListener('click', closeHistorySidebar);
    }

    if (historyOverlay) {
      historyOverlay.addEventListener('click', closeHistorySidebar);
    }

    if (newChatBtn) {
      newChatBtn.addEventListener('click', startNewChat);
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && historySidebar.classList.contains('active')) {
        closeHistorySidebar();
      }
    });
  });
  })();
</script>


