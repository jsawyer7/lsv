// Function to toggle tradition canon options based on selected religious tradition
function toggleTraditionCanon() {
  const traditionCanonGroup = document.getElementById('tradition-canon-group');
  const traditionCanonSelect = document.getElementById('tradition-canon-select');
  
  // Get selected religious tradition from dropdown
  const religiousTraditionSelect = document.querySelector('select[name="user[religious_tradition]"]');
  
  if (!religiousTraditionSelect || !traditionCanonSelect) {
    if (traditionCanonGroup) {
      traditionCanonGroup.style.display = 'none';
    }
    return;
  }
  
  // Store current value before changing options (check both value and selected option)
  const currentValue = traditionCanonSelect.value || (traditionCanonSelect.selectedOptions.length > 0 ? traditionCanonSelect.selectedOptions[0].value : '');
  if (currentValue) {
    traditionCanonSelect.setAttribute('data-current-value', currentValue);
  }
  
  const tradition = religiousTraditionSelect.value;
  
  if (tradition === 'jewish' || tradition === 'christian') {
    traditionCanonGroup.style.display = 'block';
    
    // Clear existing options
    traditionCanonSelect.innerHTML = '';
    
    // Get the appropriate canon options
    const options = canonOptions[tradition] || [];
    
    // Add options to the select
    options.forEach(function(option) {
      const optionElement = document.createElement('option');
      optionElement.value = option[1];
      optionElement.textContent = option[0];
      traditionCanonSelect.appendChild(optionElement);
    });
    
    // Restore previously selected value if it exists and is valid for this tradition
    const savedValue = traditionCanonSelect.getAttribute('data-current-value');
    if (savedValue && options.some(opt => opt[1] === savedValue)) {
      traditionCanonSelect.value = savedValue;
    }
  } else {
    // Hide canon options for muslim, other, or not_specified
    traditionCanonGroup.style.display = 'none';
    traditionCanonSelect.value = '';
    traditionCanonSelect.removeAttribute('data-current-value');
  }
}

// Function to update naming preference description
function updateNamingPreferenceDescription() {
  const namingPreferenceSelect = document.querySelector('select[name="user[naming_preference]"]');
  const descriptionElement = document.getElementById('naming-preference-description');
  
  if (!namingPreferenceSelect || !descriptionElement) return;
  
  const selectedValue = namingPreferenceSelect.value;
  const selectedOption = namingPreferenceSelect.options[namingPreferenceSelect.selectedIndex];
  
  // Get description from data attribute or text
  const description = selectedOption.getAttribute('data-description') || '';
  
  if (description && selectedValue) {
    descriptionElement.textContent = description;
    descriptionElement.style.display = 'block';
  } else {
    descriptionElement.style.display = 'none';
  }
}

